{
    "Jwt": {
        "Issuer": "ComicApi",
        "Audience": "ComicClient",
        "ExpireMinutes": 120
    },
    "RateLimits": {
        "Login": {
            "PermitLimit": 10,
            "WindowSeconds": 300
        },
        "Register": {
            "PermitLimit": 10,
            "WindowSeconds": 3600
        },
        "Chat": {
            "PermitLimit": 10,
            "WindowSeconds": 60
        }
    },
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning",
            "Microsoft.EntityFrameworkCore": "Warning"
        },
        "File": {
            "Path": "logs",
            "RetainDays": 14
        }
    },
    "OpenRouter": {
        "Model": "openrouter/free"
    },
    "AllowedHosts": "*"
}